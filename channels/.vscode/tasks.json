{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Channels: dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Channels admin: dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--strictPort"],
      "options": {
        "cwd": "${workspaceFolder}/admin"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Bears client: localhost",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "options": {
        "cwd": "${workspaceFolder}/../../bears-live-app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Bears: dry-run server",
      "type": "process",
      "command": "npm",
      "args": ["run", "dry-run"],
      "options": {
        "cwd": "${workspaceFolder}/../../bears-live-app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Bears client: 100.125.2.45",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "100.125.2.45", "--port", "5175", "--strictPort"],
      "options": {
        "cwd": "${workspaceFolder}/../../bears-live-app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start Channels + Bears (all)",
      "dependsOn": [
        "Channels: dev",
        "Channels admin: dev",
        "Bears client: localhost",
        "Bears: dry-run server",
        "Bears client: 100.125.2.45"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
