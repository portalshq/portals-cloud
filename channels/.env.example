# Copy to .env.local and fill in real values.
# .env* files are gitignored — never commit real values.
# Next.js loads .env* automatically for route handlers (no next.config wiring needed).

# ── Channels admin API (/api/admin/*) ─────────────────────────────────────────
# Bearer token required by every admin route. The SPA prompts for it on load
# (or accepts ?token= in the URL). Required — unset 503s all admin routes.
CHANNELS_ADMIN_TOKEN=29cf3134d3f0aeccde343f5052c3c852a788e0928a3a3983b52a0db13f787315

# Bears-live-app application database — channels, program_sessions,
# production_checkpoints. Same value as the bears server's DATABASE_URL.
ADMIN_APP_DATABASE_URL=

# Central platform database — stations, programs, station_schedule_rules,
# station_program_slots, next_program_session. Same value as the bears
# server's CENTRAL_DATABASE_URL. Must be a different database than
# ADMIN_APP_DATABASE_URL (the app enforces that separation).
ADMIN_CENTRAL_DATABASE_URL=

# Bears server origin for status reads (/api/health, /api/channel) and the
# production-action proxy. Needed only for the Production tab.
# NOTE: channels `next dev` also binds :4000 — run bears on another port or
# point this at wherever bears actually listens.
BEARS_API_BASE_URL=http://localhost:4000

# Server-only bearer forwarded to bears POST /api/production/{start|stop|
# test-closing}. Must equal the bears server's PRODUCTION_CONTROL_TOKEN.
# Never reaches the browser — the SPA only ever holds CHANNELS_ADMIN_TOKEN.
BEARS_PRODUCTION_CONTROL_TOKEN=

# ── Anonymous analytics ingest (pre-existing, unrelated to admin) ────────────
CHANNELS_ANALYTICS_ENABLED=
CHANNELS_SEGMENT_WRITE_KEY=
