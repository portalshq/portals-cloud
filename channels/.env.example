# Copy to .env.local and fill in real values.
# .env* files are gitignored — never commit real values.
# Next.js loads .env* automatically for route handlers (no next.config wiring needed).

# ── Channels admin API (/api/admin/*) ─────────────────────────────────────────
# Platform superuser bearer for every admin route. The SPA prompts for it on
# load (or accepts ?token= in the URL). Scoped tokens live in the central
# channel_admin_tokens table (see packages/channel-registry/sql/
# 003_channel_admin.sql) — token_hash = sha256(token) hex, channel_ids = the
# channels the token may manage. Unset + no central DB → all routes 503.
CHANNELS_ADMIN_TOKEN=

# Central platform database — the channel source of truth: stations, programs
# (incl. app_origin/app_config), station_schedule_rules, station_program_slots,
# channel_admin_tokens, channel_app_control_tokens. 
CENTRAL_DATABASE_URL=

# Optional application database used only for admin production checkpoint
# enrichment. Use a pooled URL; omit when no app database is reachable here.
APP_DATABASE_URL=

# Bears server origin: registers the bears app in the channels registry and
# acts as its production origin for status reads and the admin
# production-action proxy.
# NOTE: channels `next dev` also binds :4000 — run bears on another port or
# point this at wherever bears actually listens.
BEARS_API_BASE_URL=

# Legacy fallback forwarded to bears POST /api/production/{start|stop|
# test-closing}. Must equal the bears server's PRODUCTION_CONTROL_TOKEN.
# Prefer the central channel_app_control_tokens table for every channel,
# including new bears deployments. Never reaches the browser.
BEARS_PRODUCTION_CONTROL_TOKEN=

# ── Anonymous analytics ingest (pre-existing, unrelated to admin) ────────────
CHANNELS_ANALYTICS_ENABLED=
CHANNELS_SEGMENT_WRITE_KEY=
CHANNELS_ANALYTICS_TENANT_ID=
CHANNELS_ANALYTICS_APP_ID=
NEXT_PUBLIC_CHANNELS_ANALYTICS_ENABLED=

# Optional catalog scope. Set to a public station ID if the central DB also
# contains channels that should be excluded from discovery.
CHANNELS_CATALOG_STATION_ID=

# Optional for self-hosted Channels behind a trusted edge. The edge must
# overwrite this header with a single client IP and block direct ingress.
# Vercel's x-vercel-forwarded-for is used automatically on Vercel.
CHANNELS_TRUSTED_CLIENT_IP_HEADER=

# Shared Portals sign-in. Use the same gateway as the channel backends.
AUTH_GATEWAY_TCP_ADDRESS=
AUTH_GATEWAY_TLS=
CHANNELS_AUTH_ORIGINS=

# Durable public chat shared by Channels and every configured program backend.
# Generate one server-only value and use it for CHANNELS_CHAT_SERVICE_TOKEN on
# Channels, Bears, and the 25th Chapter. Never expose it through NEXT_PUBLIC_*.
CHANNELS_CHAT_SERVICE_TOKEN=
CHANNELS_CHAT_BLOCKED_TERMS=

# Optional Neon Realtime chat canary. Keep disabled until Realtime is enabled
# and tested on a branch. The secret is server-only; the WebSocket URL is
# intentionally public and must have the deployment origin allowlisted.
CHANNELS_REALTIME_CHAT_ENABLED=false
NEON_REALTIME_SECRET=
NEON_REALTIME_DB=
NEXT_PUBLIC_NEON_REALTIME_URL=

# Optional comma-separated exact HTTPS origins allowed to frame only
# /embed/<slug>?variant=preview. Standard and group Player Cards remain X-only.
CHANNELS_PREVIEW_FRAME_ORIGINS=
