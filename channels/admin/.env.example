# Copy to .env.local for secrets, .env.development for dev defaults.
# *.local files are gitignored — never commit real values.
# Vite picks these up per-mode: .env > .env.{mode} > .env.{mode}.local

# Dev-only: where the vite dev server proxies /api — the channels Next.js app
# that serves /api/admin/*. Matches the default baked into vite.config.ts.
VITE_ADMIN_API_ORIGIN=http://localhost:4000

# Poll interval (ms) for tab auto-refresh. Default 10000; also adjustable in
# the UI header per session.
VITE_POLL_INTERVAL_MS=10000

# OPTIONAL build-time admin token, baked into the compiled JS bundle — the
# same value as the server's CHANNELS_ADMIN_TOKEN. Prefer the token prompt or
# ?token= in dev; only bake this for non-public deployments.
VITE_ADMIN_TOKEN=
