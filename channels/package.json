{
  "name": "channels",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 100.125.2.45 -p 4000",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm run build --workspace=@portalshq/channel-registry && npm run build --workspace=@portalshq/capability-email-notifications && npm --prefix admin install --include=dev --include=optional && npm --prefix admin run build && next build",
    "start": "next start -H 100.125.2.45 -p 4000",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "update:portals": "npx npm-check-updates '/^@portalshq\\//' -u && npm install"
  },
  "dependencies": {
    "@neon/realtime": "^0.2.1",
    "@portalshq/analytics": "0.4.0",
    "@portalshq/capability-email-notifications": "^0.2.0",
    "@portalshq/capability-identity": "^0.7.0",
    "@portalshq/capability-video-delivery": "^0.3.0",
    "@portalshq/channel-registry": "0.3.0",
    "hls.js": "^1.5.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
