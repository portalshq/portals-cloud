{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedPortalsUserPools",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "portals" } }
    },
    {
      "Sid": "ManagePortalsCognitoResources",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPoolClient", "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient", "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:CreateUserPoolDomain", "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:DescribeUserPoolDomain", "cognito-idp:UpdateUserPool",
        "cognito-idp:DescribeUserPool", "cognito-idp:DeleteUserPool",
        "cognito-idp:TagResource", "cognito-idp:UntagResource",
        "cognito-idp:ListTagsForResource", "cognito-idp:SetRiskConfiguration",
        "cognito-idp:GetUserPoolMfaConfig", "cognito-idp:SetUserPoolMfaConfig"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:907199504810:userpool/*"
    },
    {
      "Sid": "CreateTaggedPortalsKmsKey",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "portals" } }
    },
    {
      "Sid": "DescribeCognitoDomainsForProviderReconciliation",
      "Effect": "Allow",
      "Action": "cognito-idp:DescribeUserPoolDomain",
      "Resource": "*"
    },
    {
      "Sid": "ManageTaggedPortalsKmsKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey", "kms:GetKeyPolicy", "kms:GetPublicKey",
        "kms:GetKeyRotationStatus",
        "kms:PutKeyPolicy", "kms:EnableKey", "kms:DisableKey",
        "kms:ScheduleKeyDeletion", "kms:CancelKeyDeletion",
        "kms:TagResource", "kms:UntagResource", "kms:ListResourceTags"
      ],
      "Resource": "arn:aws:kms:us-east-1:907199504810:key/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "portals" } }
    },
    {
      "Sid": "ManagePortalsKmsAliases",
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias"],
      "Resource": [
        "arn:aws:kms:us-east-1:907199504810:alias/portals-*",
        "arn:aws:kms:us-east-1:907199504810:key/*"
      ]
    },
    {
      "Sid": "ListKmsAliasesForProviderReconciliation",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*"
    },
    {
      "Sid": "ManagePortalsEcrRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository", "ecr:DeleteRepository", "ecr:DescribeRepositories",
        "ecr:TagResource", "ecr:UntagResource", "ecr:ListTagsForResource",
        "ecr:PutImageScanningConfiguration", "ecr:PutImageTagMutability",
        "ecr:PutLifecyclePolicy", "ecr:GetLifecyclePolicy", "ecr:DeleteLifecyclePolicy",
        "ecr:DescribeImages", "ecr:ListImages", "ecr:StartImageScan",
        "ecr:DescribeImageScanFindings", "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:907199504810:repository/portals-*/*"
    },
    {
      "Sid": "AuthenticateToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ManagePortalsCloudWatchAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms", "cloudwatch:ListTagsForResource",
        "cloudwatch:TagResource", "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:907199504810:alarm:portals-*"
    },
    {
      "Sid": "ManagePortalsAuditLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:DescribeLogGroups",
        "logs:PutRetentionPolicy", "logs:DeleteRetentionPolicy",
        "logs:TagResource", "logs:UntagResource", "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:907199504810:log-group:/aws/portals-*",
        "arn:aws:logs:us-east-1:907199504810:log-group:aws-waf-logs-portals-*",
        "arn:aws:logs:us-east-1:907199504810:log-group:/ecs/portals-*"
      ]
    },
    {
      "Sid": "ManageCloudWatchResourcePolicies",
      "Effect": "Allow",
      "Action": ["logs:PutResourcePolicy", "logs:DescribeResourcePolicies"],
      "Resource": "*"
    },
    {
      "Sid": "ManagePortalsCloudTrail",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:CreateTrail", "cloudtrail:UpdateTrail", "cloudtrail:DeleteTrail",
        "cloudtrail:StartLogging", "cloudtrail:StopLogging",
        "cloudtrail:GetTrailStatus", "cloudtrail:GetEventSelectors",
        "cloudtrail:PutEventSelectors", "cloudtrail:AddTags", "cloudtrail:RemoveTags",
        "cloudtrail:ListTags"
      ],
      "Resource": "arn:aws:cloudtrail:us-east-1:907199504810:trail/portals-*"
    },
    {
      "Sid": "DescribeCloudTrail",
      "Effect": "Allow",
      "Action": ["cloudtrail:DescribeTrails", "cloudtrail:ListTrails"],
      "Resource": "*"
    },
    {
      "Sid": "ManageVpcFlowLogs",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateFlowLogs", "ec2:DeleteFlowLogs", "ec2:DescribeFlowLogs",
        "ec2:DescribeVpcAttribute", "ec2:DescribeNetworkInterfaces", "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyPortalsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::907199504810:role/portals-*",
      "Condition": { "StringEquals": { "iam:PassedToService": ["ecs-tasks.amazonaws.com", "vpc-flow-logs.amazonaws.com"] } }
    },
    {
      "Sid": "ManagePortalsWaf",
      "Effect": "Allow",
      "Action": [
        "wafv2:CreateWebACL", "wafv2:UpdateWebACL", "wafv2:DeleteWebACL",
        "wafv2:GetWebACL", "wafv2:ListWebACLs", "wafv2:TagResource",
        "wafv2:UntagResource", "wafv2:ListTagsForResource",
        "wafv2:AssociateWebACL", "wafv2:DisassociateWebACL",
        "wafv2:GetWebACLForResource", "wafv2:PutLoggingConfiguration",
        "wafv2:DeleteLoggingConfiguration", "wafv2:GetLoggingConfiguration",
        "wafv2:ListAvailableManagedRuleGroups", "wafv2:CheckCapacity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManagePortalsServiceDiscovery",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:CreateHttpNamespace", "servicediscovery:GetNamespace",
        "servicediscovery:GetOperation", "servicediscovery:DeleteNamespace",
        "servicediscovery:ListTagsForResource",
        "servicediscovery:TagResource", "servicediscovery:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InventoryPortalsTlsAndDns",
      "Effect": "Allow",
      "Action": [
        "acm:ListCertificates", "acm:DescribeCertificate", "acm:ListTagsForCertificate",
        "route53:ListHostedZones", "route53:ListHostedZonesByName",
        "route53:GetHostedZone", "route53:ListResourceRecordSets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RequestTaggedPortalsCertificates",
      "Effect": "Allow",
      "Action": "acm:RequestCertificate",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestTag/Project": "portals" } }
    },
    {
      "Sid": "ManageTaggedPortalsCertificates",
      "Effect": "Allow",
      "Action": [
        "acm:AddTagsToCertificate", "acm:RemoveTagsFromCertificate"
      ],
      "Resource": "arn:aws:acm:us-east-1:907199504810:certificate/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "portals" } }
    }
  ]
}
