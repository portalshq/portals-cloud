{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGithubOidcTaggedReleases",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::907199504810:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": "repo:DigitalCreationsCo/portals-cloud:ref:refs/tags/v*"
        }
      }
    }
  ]
}
