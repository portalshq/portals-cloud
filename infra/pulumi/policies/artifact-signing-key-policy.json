{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableRootAccountPermissions",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::907199504810:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowReleaseIdentityToSign",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::907199504810:user/portals-pulumi-deployer"
      },
      "Action": [
        "kms:Sign",
        "kms:GetPublicKey",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    }
  ]
}