{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRReadAndPush",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:907199504810:repository/portals-prod/lore",
        "arn:aws:ecr:us-east-1:907199504810:repository/portals-prod/auth-gateway"
      ]
    },
    {
      "Sid": "ArtifactSigning",
      "Effect": "Allow",
      "Action": [
        "kms:Sign",
        "kms:GetPublicKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:907199504810:key/*",
      "Condition": {
        "StringLike": {
          "kms:KeyArn": "arn:aws:kms:us-east-1:907199504810:key/alias/portals-artifact-signing"
        }
      }
    },
    {
      "Sid": "ECSDeployment",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:907199504810:task-definition/*",
        "arn:aws:ecs:us-east-1:907199504810:service/*"
      ]
    },
    {
      "Sid": "PassECSRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::907199504810:role/portals-lore-task-*",
        "arn:aws:iam::907199504810:role/portals-auth-gateway-task-*",
        "arn:aws:iam::907199504810:role/portals-*execution-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadOnlyHealthAndLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricStatistics",
        "ecs:DescribeContainerInstances",
        "ecs:DescribeTasks"
      ],
      "Resource": "*"
    }
  ]
}
