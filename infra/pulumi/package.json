{
  "name": "portals-platform-infrastructure",
  "version": "1.0.0",
  "description": "Production-grade Pulumi AWS infrastructure stack for Portals platform",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "tsx --test tests/*.test.ts && ../../control-plane/scripts/test-pipeline.sh",
    "validate:ec2-capacity": "node scripts/validate-ec2-capacity.mjs",
    "validate:public-host-runtime": "node scripts/validate-public-host-runtime.mjs",
    "predeploy": "npm run build && npm run validate:ec2-capacity",
    "deploy": "pulumi up",
    "destroy": "pulumi destroy",
    "preview": "pulumi preview"
  },
  "keywords": [
    "pulumi",
    "aws",
    "infrastructure",
    "ecs",
    "fargate",
    "aurora"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pulumi/aws": "^6.0.0",
    "@pulumi/awsx": "^2.0.0",
    "@pulumi/pulumi": "^3.0.0",
    "@pulumi/random": "^4.21.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
