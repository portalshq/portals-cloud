DATABASE_URL=__REPLACE_AUTH_POSTGRES_TLS_URL__
GRPC_LISTEN_ADDR=0.0.0.0:8084
HTTP_LISTEN_ADDR=0.0.0.0:8085
INTERNAL_LISTEN_ADDR=0.0.0.0:8086
REBAC_LISTEN_ADDR=0.0.0.0:8087
PUBLIC_BASE_URL=https://__REPLACE_AUTH_DOMAIN__
OIDC_ISSUER=https://__REPLACE_ZITADEL_ISSUER_HOST__
OIDC_CLIENT_ID=__REPLACE_ZITADEL_PUBLIC_CLIENT_ID__
OIDC_REDIRECT_URI=https://__REPLACE_AUTH_DOMAIN__/callback
JWT_ISSUER=https://__REPLACE_AUTH_DOMAIN__
JWT_KID=__REPLACE_UNIQUE_SIGNING_KEY_ID__
JWT_SIGNING_ENABLED=true
JWT_SIGNING_PROVIDER=sealed-file
JWT_LOCAL_PRIVATE_KEY_PATH=/run/secrets/auth/signing-key
# During rotation only: JWT_LOCAL_RETIRED_JWKS_PATH=/run/secrets/auth/retired-jwks.json
API_KEY_PEPPER_PROVIDER=sealed-file
API_KEY_PEPPER_FILE_PATH=/run/secrets/auth/api-key-pepper
INTERNAL_ADMIN_TOKEN=__REPLACE_RANDOM_MINIMUM_32_BYTE_ADMIN_TOKEN__
LORE_ENV=prod
AWS_EC2_METADATA_DISABLED=true
RUST_LOG=info
