# On andresb, copy this file to /Users/portals-svc/portals-release.env as
# portals-svc after changing to /Users/portals-svc/portals/infra/mac-bootstrap.
# Keep it owned by portals-svc, mode 600. Existing private files must not be
# overwritten by template copies. Replace every __REPLACE_*__ value.
# This file is sourced as shell assignments: no command substitutions or
# additional shell commands, and never paste tokens or its contents into chat.

# Immutable Docker Hub release digests. These must match the promoted image
# pins in infra/lore/versions.yaml; check-release.mjs verifies Auth and Lore.
AUTH_GATEWAY_IMAGE_DIGEST=portalshq/auth-gateway@sha256:96a4f5dffb40e22192043ad091e4414a0791408c2f435b98c41ef427f719b162
LORE_IMAGE_DIGEST=portalshq/lore@sha256:be13e82521606050a5dcfaaef2a550af89994ae02d98907b7a7b7f95cff3d9bf
CADDY_IMAGE_DIGEST=caddy@sha256:13b7fbadd017b042956fddbceedeeea12bb1e560534f9b3df281269dbcc61813

# Hostnames Caddy serves. Production uses these names and the corresponding
# wildcard certificate; Pinggy-assigned staging names need separate settings
# and matching certificate validation before an external TLS test.
AUTH_DOMAIN=auth.portals.works
LORE_DOMAIN=lore.portals.works

# Private service files on the Mac. auth.env contains Auth's PostgreSQL URL,
# ZITADEL issuer/client ID, and Auth settings; its DATABASE_URL is not Vercel's
# LEADS_DATABASE_URL. The Auth secrets directory holds signing-key and
# api-key-pepper. Do not place those secret file contents in this release file.
AUTH_ENV_FILE=/Users/portals-svc/secrets/auth.env
AUTH_SECRET_DIR=/Users/portals-svc/secrets/auth

# Lore configuration contains AWS region and resource names; the separate
# lore-aws.env contains only AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY for
# the scoped Lore workload identity. Compose loads both files for Lore.
LORE_ENV_FILE=/Users/portals-svc/secrets/lore.env
LORE_AWS_ENV_FILE=/Users/portals-svc/.config/portals/lore-aws.env

# Caddy names live in caddy.env. Caddy and Lore QUIC read fullchain.pem and
# privkey.pem from their respective directories. Caddy's wildcard certificate
# does not cover a Pinggy-owned QUIC hostname.
CADDY_ENV_FILE=/Users/portals-svc/secrets/caddy.env
CADDY_CERT_DIR=/Users/portals-svc/secrets/caddy-certs
LORE_QUIC_CERT_DIR=/Users/portals-svc/secrets/lore-quic-certs

# Put the dashboard-generated, persistent foreground tunnel commands here.
# TCP/TLS passthrough forwards to 127.0.0.1:8443 (Caddy); UDP forwards to
# 127.0.0.1:41337 (Lore). The commands include private Pinggy tokens: never
# commit or print them. Each command must contain StrictHostKeyChecking=yes
# and UserKnownHostsFile=/Users/portals-svc/.ssh/known_hosts. Verify the
# gateway key's fingerprint independently before adding it to known_hosts.
# run-pinggy.sh currently starts TWO commands/sessions; confirm the paid seat
# supports both simultaneously before using these production entries.
PINGGY_TCP_COMMAND='__REPLACE_DASHBOARD_PERSISTENT_TLS_COMMAND__'
PINGGY_UDP_COMMAND='__REPLACE_DASHBOARD_PERSISTENT_UDP_COMMAND__'
PINGGY_KNOWN_HOSTS_FILE=/Users/portals-svc/.ssh/known_hosts

# Use the reserved public UDP hostname and port actually reported by Pinggy.
# The hostname must match the certificate presented by Lore's QUIC listener.
# These are public mapping values, not Lore's local UDP port 41337.
LORE_QUIC_HOST=__REPLACE_RESERVED_QUIC_CERTIFICATE_HOST__
LORE_QUIC_PORT=__REPLACE_RESERVED_UDP_PORT__

# Real external acceptance commands, built with the pinned authenticated
# clients/test harness after the public mappings are known. They must prove
# Auth gRPC, Lore gRPC, Lore QUIC, and cross-repository denial respectively;
# a port-open check or an unauthenticated health request is insufficient.
AUTH_GRPC_PROBE_COMMAND='__REPLACE_AUTHENTICATED_AUTH_GRPC_PROBE__'
LORE_GRPC_PROBE_COMMAND='__REPLACE_AUTHENTICATED_LORE_GRPC_PROBE__'
LORE_QUIC_PROBE_COMMAND='__REPLACE_PINNED_CLIENT_QUIC_PROBE__'
TENANT_DENIAL_PROBE_COMMAND='__REPLACE_ALL_REPOSITORY_RPC_DENIAL_SUITE__'
