<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.portals.cloudflared</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--no-autoupdate</string>
    <string>--loglevel</string><string>info</string>
    <string>run</string>
    <string>--token-file</string>
    <string>/Users/andresb/.config/cloudflared/portals-andresb-web.token</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/andresb/Library/Logs/portals-cloudflared.log</string>
  <key>StandardErrorPath</key><string>/Users/andresb/Library/Logs/portals-cloudflared.err.log</string>
</dict></plist>
