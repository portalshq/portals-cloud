# =============================================================================
# Dockerfile.loreserver.base — Lore Server Base Image
# =============================================================================
#
# Builds a custom loreserver binary with the AWS plugin (S3 + DynamoDB)
# compiled in, excluding unused plugins (hashicorp/consul).
#
# Produces an ECR multi-architecture manifest. The publishing script resolves
# and records its immutable digest before building the runtime image.
#
# This image is reusable across environments. No Portals-specific
# configuration is baked in. Configuration belongs in the derived image
# (Dockerfile.loreserver) and is mounted at runtime.
#
# Production publishing is centralized in
# infra/lore/scripts/docker-buildx-lore.sh and requires ECR_REGISTRY.
#
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder — compile the custom loreserver binary
# ---------------------------------------------------------------------------
# Builder runs natively on the build machine ($BUILDPLATFORM). amd64 is built
# natively and arm64 is cross-compiled, so the resulting runtime manifest can
# serve either supported ECS host architecture without QEMU.
FROM --platform=$BUILDPLATFORM rust:slim-trixie@sha256:3b2879047d42784ca9403ad20c51ed3df361a50f1df96f5777d39b4e33aa65cd AS builder

# Prevent apt from prompting for configuration
ARG DEBIAN_FRONTEND=noninteractive

# Install build dependencies plus the arm64 cross-compilation toolchain.
RUN apt-get update && apt-get install -y \
    build-essential \
    protobuf-compiler \
    cmake \
    pkg-config \
    gcc-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    binutils-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Add the non-native target used when producing arm64 from an amd64 builder.
RUN rustup target add aarch64-unknown-linux-gnu

# Copy the entire workspace including vendor (patched quinn-proto)
COPY . .

# ---------------------------------------------------------------------------
# Remove plugins and dependencies we do NOT compile:
#   - hashicorp/consul plugin (unused)
# ---------------------------------------------------------------------------
RUN rm -f lore-server/src/plugins/hashicorp.rs \
    && sed -i '/lore-hashicorp/d' lore-server/Cargo.toml \
    && sed -i '/pub mod hashicorp;/d; /hashicorp::register(registry);/d' lore-server/src/plugins/mod.rs

# Select the appropriate compilation path. The source configuration contains
# a Graviton-specific arm64 tuning flag, so remove it for the portable arm64
# container build. amd64 uses Cargo's native Linux target.
ARG TARGETPLATFORM
ARG LORE_BUILD_VERSION_NAME
RUN case "$TARGETPLATFORM" in \
      linux/arm64) sed -i '/target-cpu=neoverse-512tvb/d' .cargo/config.toml ;; \
      linux/amd64) : ;; \
      *) echo "unsupported TARGETPLATFORM: $TARGETPLATFORM (expected linux/amd64 or linux/arm64)" >&2; exit 1 ;; \
    esac \
    && test -n "$LORE_BUILD_VERSION_NAME" \
    || { echo "LORE_BUILD_VERSION_NAME must contain the immutable Lore release tag" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Build the release binary for the requested runtime platform.
# ---------------------------------------------------------------------------
# The binary is compiled with the `release-lto` profile (fat LTO, full
# debuginfo, no debug assertions) when available, otherwise `release`.
# See [profile.release-lto] in the workspace Cargo.toml.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    export LORE_BUILD_VERSION_NAME \
    && \
    case "$TARGETPLATFORM" in \
      linux/arm64) \
        CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
        cargo build --release --target aarch64-unknown-linux-gnu --jobs 1 --bin loreserver -p lore-server \
        && cp /build/target/aarch64-unknown-linux-gnu/release/loreserver /loreserver-bin \
        && aarch64-linux-gnu-strip /loreserver-bin \
        ;; \
      linux/amd64) \
        cargo build --release --jobs 1 --bin loreserver -p lore-server \
        && cp /build/target/release/loreserver /loreserver-bin \
        && strip /loreserver-bin \
        ;; \
      *) echo "unsupported TARGETPLATFORM: $TARGETPLATFORM (expected linux/amd64 or linux/arm64)" >&2; exit 1 ;; \
    esac

# ---------------------------------------------------------------------------
# Stage 2: Runtime base — shell-free, nonroot distroless image
# ---------------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM gcr.io/distroless/cc-debian13:nonroot@sha256:d97bc0a941b8d4be647dc0ee75b264ddbb772f1ac5ba690a4309c00723b23775

# Copy the compiled binary
COPY --chown=65532:65532 --from=builder /loreserver-bin /usr/local/bin/loreserver

# Copy the upstream default.toml so the server starts with sensible
# defaults even when no external config directory is mounted. This is
# the ORIGINAL upstream config; Portals-specific overrides go in the
# derived image (Dockerfile.loreserver).
COPY --chown=65532:65532 --from=builder /build/lore-server/config/default.toml /etc/lore/config/default.toml

# Environment defaults
ENV LORE_CONFIG_PATH=/etc/lore/config
ENV RUST_LOG=info

# Expose ports:
#   41337/tcp — gRPC (public API)
#   41337/udp — QUIC (public API)
#   41339/tcp — HTTP (health check, presigned URLs, admin)
EXPOSE 41337 41337/udp 41339

# Persistent data volume
VOLUME /data

WORKDIR /data

USER 65532:65532

# Default entrypoint — no flags needed because LORE_CONFIG_PATH and
# LORE_ENV are set via environment variables
ENTRYPOINT ["/usr/local/bin/loreserver"]
