{
  "name": "@portalshq/capability-identity",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portalshq/portals-cloud.git",
    "directory": "packages/capability-identity"
  },
  "description": "Federated audience identity, persistent across every channel — current and future, platform-provided and developer-created.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "sql",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/copy-proto.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "vitest": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
