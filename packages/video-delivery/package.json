{
  "name": "@portalshq/capability-video-delivery",
  "version": "0.1.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portalshq/portals-cloud.git",
    "directory": "packages/video-delivery"
  },
  "description": "Configured HLS stream delivery for application-owned programming and scheduling.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@portalshq/contracts": "^0.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
