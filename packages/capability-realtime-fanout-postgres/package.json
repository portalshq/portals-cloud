{
  "name": "@portalshq/capability-realtime-fanout-postgres",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portalshq/portals-cloud.git",
    "directory": "packages/capability-realtime-fanout-postgres"
  },
  "description": "PostgreSQL-backed durable FanoutBus: messages survive process restarts and fan out across processes via polling.",
  "type": "module",
