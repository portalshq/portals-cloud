              "video",
              "image",
              "audio"
            ],
            "title": "Media Type",
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "slot_key": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot Key"
          },
          "staged": {
            "default": false,
            "title": "Staged",
            "type": "boolean"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_uploadQueueItem",
        "type": "object"
      },
      "Body_uploadQueuePair": {
