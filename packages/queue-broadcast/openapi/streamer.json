            "minLength": 64,
            "title": "Audio Sha256",
            "type": "string"
          },
          "image": {
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "type": "string"
          },
          "image_duration": {
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Image Duration",
            "type": "number"
          },
          "image_sha256": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Image Sha256",
            "type": "string"
          },
          "staged": {
            "default": false,
            "title": "Staged",
            "type": "boolean"
          }
        },
        "required": [
          "image",
          "audio",
          "image_duration",
          "image_sha256",
          "audio_sha256"
        ],
        "title": "Body_uploadQueuePair",
        "type": "object"
      },
      "ErrorResponse": {
