{
  "name": "@portalshq/capability-email-notifications",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portalshq/portals-cloud.git",
    "directory": "packages/capability-email-notifications"
  },
  "description": "Provider-backed email notification delivery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "node dist/worker.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "resend": "^6.9.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
