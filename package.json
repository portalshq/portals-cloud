{
  "name": "portals-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "description": "Capability-first infrastructure platform for composable entertainment channels. ",
  "workspaces": [
    "channels",
    "frontend",
    "packages/*",
    "lib/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prepare": "test -d .git && test -x node_modules/.bin/husky && husky || echo 'Skipping Husky (Not a local Git repo)'",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release:build": "node scripts/release-packages.mjs build",
    "release:check": "node scripts/release-packages.mjs check",
    "release:trust": "node scripts/setup-npm-trust.mjs",
    "release": "npm run release:build && npm run release:check && changeset publish",
    "local-version-script": "npm run release:version",
    "local-publish-script": "npm run release",
    "skills:build": "node scripts/build-skills.mjs",
    "skills:check": "node scripts/build-skills.mjs --check"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "packageManager": "npm@12.0.2"
}
